<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch screen: use a dedicated padded HPJ splash asset
         instead of allowing Android to enlarge/mask the launcher icon. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#F4F9F2</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/hpj_splash_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
